@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #17243b;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --navy: #101c32;
  --blue: #2878ff;
  --purple: #8055e8;
  --muted: #68758b;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; min-width: 320px; }
a { color: inherit; text-decoration: none; }
button, input { font: inherit; }
.site-shell { max-width: 1440px; margin: 0 auto; overflow: hidden; }
.topbar { min-height: 76px; padding: 0 7%; display: flex; align-items: center; justify-content: space-between; gap: 24px; background: #fff; }
.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--navy); font-weight: 600; letter-spacing: .02em; white-space: nowrap; }
.brand strong { font-weight: 800; }
.brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 11px; color: #fff; background: linear-gradient(135deg, var(--blue), var(--purple)); font-family: Manrope, sans-serif; font-weight: 800; }
nav { display: flex; gap: 28px; color: #526078; font-size: 14px; }
nav a:hover { color: var(--blue); }
.language-button { border: 1px solid #e2e7f0; background: white; border-radius: 9px; padding: 9px 12px; color: var(--navy); }
.hero { padding: 100px 20px 92px; text-align: center; color: white; background: radial-gradient(ellipse at 80% 0%, #3e4c91 0%, transparent 42%), linear-gradient(130deg, #101c32, #172d50 65%, #25336a); }
.eyebrow { margin: 0 0 14px; color: #6f9fff; font-size: 11px; font-weight: 700; letter-spacing: .16em; }
.hero h1, h2, h3 { font-family: Manrope, sans-serif; }
.hero h1 { margin: 0; font-size: clamp(38px, 6vw, 66px); line-height: 1.08; letter-spacing: -.045em; }
.hero h1 span { color: #91b7ff; }
.hero-copy { max-width: 600px; margin: 22px auto 30px; color: #d3dced; line-height: 1.7; }
.search { display: flex; max-width: 620px; margin: 0 auto; padding: 6px; border-radius: 13px; background: white; box-shadow: 0 16px 45px #07152b55; }
.search input { flex: 1; min-width: 0; border: 0; outline: 0; padding: 12px 14px; color: var(--navy); }
.search button { border: 0; border-radius: 9px; padding: 0 22px; color: white; background: var(--blue); font-weight: 700; }
.microcopy { margin: 15px 0 0; color: #b7c5db; font-size: 12px; }
.section { padding: 76px 7%; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
.section-heading h2, .assist-panel h2, .modules h2 { margin: 0; color: var(--navy); font-size: clamp(25px, 3vw, 36px); letter-spacing: -.035em; }
.section-note { color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .1em; }
.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.category-card { min-height: 190px; padding: 23px; border: 1px solid #e7ebf3; border-radius: 16px; background: white; }
.card-symbol { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 11px; color: var(--blue); background: #edf3ff; font-size: 20px; }
.category-card h3 { margin: 19px 0 8px; color: var(--navy); font-size: 17px; }
.category-card p, .modules p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
.assist-panel { margin: 0 7% 35px; padding: 38px 42px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-radius: 20px; background: #eaf0ff; }
.assist-panel p:last-child { max-width: 560px; color: #5d6b82; line-height: 1.7; }
.assist-icon { color: var(--purple); font-size: 70px; }
.modules { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding-top: 35px; }
.modules article { padding: 30px; border: 1px solid #e7ebf3; border-radius: 16px; background: white; }
.modules h2 { margin-bottom: 10px; font-size: 22px; }
footer { padding: 30px 7%; display: flex; align-items: center; justify-content: space-between; gap: 20px; background: var(--navy); color: #d6dfed; }
footer p, footer small { color: #aab8cc; font-size: 12px; }
.footer-brand { color: white; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

@media (max-width: 800px) {
  .topbar { padding: 16px 5%; flex-wrap: wrap; }
  nav { order: 3; width: 100%; overflow-x: auto; gap: 20px; padding: 4px 0; }
  .hero { padding: 75px 20px; }
  .section { padding: 55px 5%; }
  .category-grid { grid-template-columns: repeat(2, 1fr); }
  .assist-panel { margin: 0 5% 25px; padding: 28px; }
  footer { padding: 25px 5%; flex-wrap: wrap; }
}
@media (max-width: 480px) {
  .category-grid, .modules { grid-template-columns: 1fr; }
  .search { flex-direction: column; gap: 6px; }
  .search button { min-height: 45px; }
  .section-heading { align-items: start; flex-direction: column; }
  .assist-icon { display: none; }
  footer { flex-direction: column; align-items: flex-start; }
}
