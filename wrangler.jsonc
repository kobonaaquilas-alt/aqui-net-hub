{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aqui-net-hub",
  "compatibility_date": "2026-11-06",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./worker/index.ts"
}
