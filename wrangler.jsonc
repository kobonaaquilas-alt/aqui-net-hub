    "SUPABASE_ANON_KEY": "sb_publishable_AGtfBQyqyKbH5C_4f5cQgw_bm0MmusA",
    "FACEBOOK_APP_ID": "2911303309226990",
    "FACEBOOK_GRAPH_VERSION": "v26.0"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
