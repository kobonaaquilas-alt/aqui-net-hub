{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aqui-net-hub",
  "compatibility_date": "2026-11-06",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ads.txt",
      "/terms",
      "/privacy",
      "/tiktok*"
    ]
  },
  "main": "./worker/index.ts",
  "vars": {
    "SUPABASE_URL": "https://xbobkysbtvtmepqgtnbt.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_AGtfBQyqyKbH5C_4f5cQgw_bm0MmusA",
    "FACEBOOK_APP_ID": "2911303309226990",
    "FACEBOOK_GRAPH_VERSION": "v26.0"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_AD_LIMITER",
      "namespace_id": "823741",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AD_EVENT_LIMITER",
      "namespace_id": "823742",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "ADS_USER_LIMITER",
      "namespace_id": "823743",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "ADS_IP_LIMITER",
      "namespace_id": "823744",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "BROWSER_TASK_LIMITER",
      "namespace_id": "823745",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SECURITY_ALERT_LIMITER",
      "namespace_id": "823746",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ]
}
